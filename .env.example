APP_ENV=development
APP_SECRET=replace-with-a-long-random-value
OTP_PEPPER=replace-with-another-long-random-value

# PostgreSQL. El backend lee estas variables y arma la URL de conexión de forma segura.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_EXTERNAL_PORT=5432
POSTGRES_DB=imagen_report
POSTGRES_USER=imagen_report
POSTGRES_PASSWORD=replace-with-a-strong-local-password

FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
APP_DOMAIN=localhost
APP_SCHEME=http

# Usuario inicial. Cambiar antes del primer despliegue.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-now

# SMTP para códigos de acceso. En desarrollo, el código también se devuelve en la respuesta.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Google Sheet de entrada (solo lectura)
GOOGLE_SHEETS_SERVICE_ACCOUNT_FILE=/run/secrets/google-service-account.json
GOOGLE_SHEET_ID=1ATTcmm3rs4NjpBoD0113-Oht-YieQx-PdPk3b4SVJqU
GOOGLE_SHEET_RANGE="'Hoja 1'!A11:K"
SHEET_PATIENT_NAME_HEADER=NOMBRE
SHEET_PATIENT_ID_HEADER=CEDULA
SHEET_DOCTOR_HEADER=DR.
SHEET_RECIPIENT_EMAIL_HEADER=ENVIO A...

# Gemini: solo se utiliza desde FastAPI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Cuenta Google (Gmail personal o Google Workspace) para Docs y Drive.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_OAUTH_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_DOCS_TEMPLATE_ID=1K9VviEhFYcvEGruV5a3L8iBxnjX72J7c_8hB7rO99UE
GOOGLE_DRIVE_OUTPUT_FOLDER_ID=1OZXqOoi57mwh4hhYyBjECQ_5TgFfU1Ez

# Borrador de Gmail: integración desactivada por defecto.
GMAIL_DRAFT_ENABLED=false
GMAIL_USER_ID=me
